{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@kilo-webview": ["../kilo-vscode/webview-ui"],
      "@kilo-webview/*": ["../kilo-vscode/webview-ui/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "extension/**/*"],
  "exclude": ["node_modules", "dist", "extension/dist", "extension/ui-dist"]
}
